<!doctype html>
<html class="bg">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    {squarespace-headers}
  </head>
  {@|apply SiteBlocks/googleAnalytics.block}
  <body id="{squarespace.page-id}" class="{squarespace.page-classes}">
  <main class="content-container fade-in-delay" role="main" data-content-field="main-content">
    <squarespace:navigation navigationId="siteNav" template="site-navigation" />
      
      <section class="flex-start-start flex-column">
        <div class="promo-banner">
            <squarespace:block-field id="PromoBanner" columns="1" />
        </div>
        <div class="page-hero page-hero-editable {collection.title|slugify}-hero {.equal?:collection.mainImage.contentType:"text/html"}{.or}{.if item.assetUrl} bg-set {.or} {.if collection.mainImage.assetUrl} bg-set {.or}{.end} {.end}{.end} flex-center-center" {.equal?:collection.mainImage.contentType:"text/html"}{.or}{.if item.assetUrl} style="background-image: url('{item.assetUrl}');" {.or} style="background-image: url('{collection.mainImage.assetUrl}');" {.end}{.end}>
            <div class="page-hero-content flex-start-center flex-column white-text">
                <squarespace:block-field id="{collection.title}-Title" columns="1" class="page-hero-editable-block"/>
                <a class="button red-button" style="margin-top: 10px;" href="#Book">Book Services</a>
            </div>
        </div>
        
      </section>

      <section id="PromoCards" class="basic-padding" style="margin-top: -100px;">
        <div class="promo-card-wrapper flex-stretch-center">
            <div class="promo-card box-shadow flex-start-center flex-column">
                <div class="promo-card-icon" style="background-image: url('../assets/icons/savings.svg')"></div>
                <squarespace:block-field id="PromoCard-1-Description" columns="1" />
            </div>

            <div class="promo-card box-shadow flex-start-center flex-column">
                <div class="promo-card-icon" style="background-image: url('../assets/icons/same-day.svg')"></div>
                <squarespace:block-field id="PromoCard-2-Description" columns="1" />
            </div>

            <div class="promo-card box-shadow flex-start-center flex-column">
                <div class="promo-card-icon" style="background-image: url('../assets/icons/certified-red.svg')"></div>
                <squarespace:block-field id="PromoCard-3-Description" columns="1" />
            </div>
        </div>
      </section>

        <section class="basic-padding" id="Book">
            <squarespace:block-field id="PromoDescription" columns="1" class="basic-padding"/>
            <div class="flex-start-start flex-wrap basic-padding" style="padding-top: 0;">
            <squarespace:query collection="locations" limit="10">
                {.repeated section items}
                    {.if starred}
                        {@|apply Locations/windshieldOnlyMapGrid.block}
                    {.end}
                {.end}
            </squarespace:query>
            </div>
        </section>


      

        <section class="basic-padding" id="whatToExpectCards" style="z-index: 2; margin-top: 50px;">
            <squarespace:block-field id="WhatToExpect-Description" columns="1" />
            {@|apply SiteBlocks/completeAdasSolutionCards.block}
        </section>

        <section class="basic-padding banner-bg-reverse" style="margin-top: -175px; padding-top: 200px; z-index: 1;">
            <squarespace:block-field id="GetStarted-Description" columns="1" />
            <squarespace:block-field id="RequestAQuote" columns="1" />
        </section>

        {@|apply siteBlocks/callToAction.block}

    </main>
    <squarespace:script src="site.js" combo="{.if authenticatedAccount}false{.or}true{.end}" />
    {squarespace-footers}
  </body>
</html>
